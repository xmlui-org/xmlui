                url="/blog/:slug"
            >
                <script>
                    var post = appGlobals.allPosts.find(p => p.slug === $routeParams.slug)
                </script>
                <BlogPage
                    when="{post}"
                    post="{post}"
                />
                <Redirect
                    when="{!post}"
                    to="/404"
                />
            </Page>

